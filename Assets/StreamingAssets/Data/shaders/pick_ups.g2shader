models/pick_ups/rmg_tnt
{
	q3map_nolightmap
	q3map_onlyvertexlighting
    {
        map models/pick_ups/rmg_tnt
        rgbGen lightingDiffuse
    }
    {
        map models/pick_ups/rmg_tnt_glow
        blendFunc GL_ONE GL_ONE
        rgbGen wave sin 0.5 100 100 1
    }
}

models/pick_ups/rmg_briefase
{
	q3map_material	SolidMetal
	q3map_nolightmap
	q3map_onlyvertexlighting
    {
        map models/pick_ups/rmg_briefase
        rgbGen lightingDiffuse
    }
    {
        map models/pick_ups/rmg_briefase
        blendFunc GL_ONE GL_ONE
        rgbGen wave sin 0.25 0.25 0 1
    }
}

