textures/armory/com_panel_wide
{
	qer_editorimage	textures/armory/com_panel_wide
	q3map_material	SolidMetal
	q3map_nolightmap
	q3map_onlyvertexlighting
    {
        map textures/colors/black_100
    }
    {
        map textures/armory/com_panel_wide2_dots
        blendFunc GL_ONE GL_ONE
        rgbGen wave sin 0 5 0 0.25
        tcMod scroll -0.3 0
    }
    {
        map textures/armory/com_panel_wide
        blendFunc GL_SRC_ALPHA GL_ONE_MINUS_SRC_ALPHA
    }
    {
        map textures/armory/com_panel_wide_red
        blendFunc GL_ONE GL_ONE
        rgbGen wave sin 0 5 0 0.6
    }
    {
        map textures/armory/com_panel_wide_purp
        blendFunc GL_ONE GL_ONE
        rgbGen wave sin 0 0.5 0 1
    }
    {
        map textures/armory/com_panel_wide_green
        blendFunc GL_ONE GL_ONE
        rgbGen wave sin 0 1 0 1
    }
}

