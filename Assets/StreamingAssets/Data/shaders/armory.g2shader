textures/armory/tut_water_reflect
{
	q3map_tesssize	128
	surfaceparm	nonsolid
	surfaceparm	nonopaque
	surfaceparm	water
	surfaceparm	trans
	q3map_material	Water
	q3map_nolightmap
	cull	disable
    {
        map textures/common/water_pool
        blendFunc GL_SRC_ALPHA GL_ONE_MINUS_SRC_ALPHA
        rgbGen vertex
        alphaGen const 0.3
        tcMod turb 0 0.1 0 0.1
    }
    {
        map textures/armory/tut_water_reflect
        blendFunc GL_SRC_ALPHA GL_ONE_MINUS_SRC_ALPHA
        detail
        alphaGen const 0.075
        tcGen environment
    }
}

