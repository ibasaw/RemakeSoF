    {
        map $lightmap
    }
    {
        map textures/armory/monitor_world
        blendFunc GL_DST_COLOR GL_ZERO
    }
    {
// On a 3dfx card this will draw over the frame

        map textures/armory/monitor_world_e
        blendFunc GL_ONE_MINUS_DST_ALPHA GL_ONE
        detail
        tcMod scroll 0.05 0
    }
    {
        animMap 3 textures/armory/monitor_world_a textures/armory/monitor_world_b textures/armory/monitor_world_c textures/armory/monitor_world_d 
        blendFunc GL_ONE GL_ONE
        detail
    }
}

