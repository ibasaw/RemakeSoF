textures/armory/com_panel_wide_alexi
{
	qer_editorimage	textures/armory/com_panel_widealexi
	q3map_material	SolidMetal
	q3map_nolightmap
	q3map_onlyvertexlighting
    {
        map textures/colors/black_100
    }
    {
        map textures/armory/com_panel_wide2_dots
        blendFunc GL_ONE GL_ZERO
        rgbGen wave sin 0 5 0 5
        tcMod scroll -0.2 0
    }
    {
        map textures/armory/com_panel_widealexi
        blendFunc GL_SRC_ALPHA GL_ONE_MINUS_SRC_ALPHA
    }
    {
        map textures/armory/com_panel_wide2_lights
        blendFunc GL_ONE GL_ONE
        rgbGen wave sin 0 5 0 0.25
    }
}

