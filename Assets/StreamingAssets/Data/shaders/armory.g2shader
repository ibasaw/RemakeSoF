	q3map_material	Computer
    {
        map $lightmap
    }
    {
        map textures/armory/sign_hotel
        blendFunc GL_DST_COLOR GL_ZERO
    }
    {
        map textures/armory/sign_hotel_glow
        blendFunc GL_ONE GL_ONE
        detail
    }
    {
        map textures/armory/sign_hotel2_glow
        blendFunc GL_ONE GL_ONE
        detail
        rgbGen wave sin 0 3 0 8
    }
}

textures/armory/messrecord_decal
{
	polygonOffset
	q3map_material	Plastic
	aliasShader	textures/armory/messpaper2_decal
    {
        map textures/armory/messrecord_decal
        alphaFunc GE128
        blendFunc GL_SRC_ALPHA GL_ZERO
        depthWrite
    }
    {
        map $lightmap
        blendFunc GL_ONE GL_ZERO
        depthFunc equal
    }
    {
        map textures/armory/messrecord_decal
        blendFunc GL_DST_COLOR GL_ZERO
        depthFunc equal
    }
}

