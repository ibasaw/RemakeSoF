models/objects/hospital/misc/test_tube_tray
{
	q3map_material	Glass
	q3map_nolightmap
	q3map_onlyvertexlighting
	sort	outside
	cull	disable
    {
        map models/objects/hospital/misc/test_tube_tray
        blendFunc GL_SRC_ALPHA GL_ONE_MINUS_SRC_ALPHA
        depthWrite
        rgbGen lightingDiffuse
    }
}

