models/objects/kamchatka/tree2b_shd
{
	q3map_material	Snow
	q3map_nolightmap
	deformvertexes	wave	5 sin 0 2 0.5 0.125
    {
        map models/objects/kamchatka/tree2b_shd
        alphaFunc GE128
        blendFunc GL_ONE GL_ZERO
        rgbGen lightingDiffuse
    }
}

