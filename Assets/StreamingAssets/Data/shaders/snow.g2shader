models/characters/snow/a_rainsuit
{
	q3map_material	Flesh
	q3map_nolightmap
	q3map_onlyvertexlighting
	hitLocation	models/characters/snow/a_snow_hit
    {
        map models/characters/snow/a_rainsuit
        rgbGen lightingDiffuse
    }
    {
        clampmap gfx/sprites/rainhit
            surfaceSprites effect 2 16 1 1200
            ssFaceup
            ssFXDuration 135
            ssFXGrow 6 6
            ssFXWeather
        blendFunc GL_ONE GL_ONE
        detail
    }
}

