textures/instances/canvas_btm_winter
{
	qer_editorimage	textures/common/canvas_btm_winter
	q3map_material	Canvas
	surfaceparm	slime
	q3map_nolightmap
	q3map_onlyvertexlighting
    {
        map textures/common/canvas_btm_winter
        rgbGen lightingDiffuse
    }
}

