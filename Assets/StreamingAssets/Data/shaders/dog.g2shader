{
	qer_editorimage	models/characters/dog/dog1
	q3map_material	Flesh
	q3map_nolightmap
	q3map_onlyvertexlighting
	hitLocation	models/characters/dog/dog_hit
    {
        map models/characters/dog/dog2
        rgbGen lightingDiffuse
    }
}

