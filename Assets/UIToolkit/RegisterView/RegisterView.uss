/* ============================================================
   Input fields — base visibility on the full-black backdrop.
   Hover/focus pulses borrowed from LoginView for consistency.
   Rules scoped to .register-form so they don't leak into other
   views sharing the same PanelSettings.
   ============================================================ */

.register-form > .unity-text-field {
    margin-bottom: 8px;
}

.register-form > .unity-text-field > .unity-text-field__input {
    background-color: rgb(40, 40, 40);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgba(255, 255, 255, 0);
    border-right-color: rgba(255, 255, 255, 0);
    border-top-color: rgba(255, 255, 255, 0);
    border-bottom-color: rgba(255, 255, 255, 0);
    transition-property: border-color, background-color;
    transition-duration: 120ms;
}

.register-form > .unity-text-field > .unity-text-field__input:hover {
    border-left-color: rgb(255, 255, 255);
    border-right-color: rgb(255, 255, 255);
    border-top-color: rgb(255, 255, 255);
    border-bottom-color: rgb(255, 255, 255);
    background-color: rgb(55, 55, 55);
}

.register-form > .unity-text-field > .unity-text-field__input:focus {
    border-left-color: rgb(80, 200, 255);
    border-right-color: rgb(80, 200, 255);
    border-top-color: rgb(80, 200, 255);
    border-bottom-color: rgb(80, 200, 255);
    background-color: rgb(25, 40, 55);
}

/*
   Fixed height + zero margins are intentional: an auto-sized Label
   whose .text changes from "" to a hint forces the parent column to
   re-measure, which re-lays out the focused TextField's caret and
   drops keyboard focus mid-keystroke (Unity 6 UITK).
*/
.register-form > .field-hint {
    color: rgb(160, 160, 160);
    font-size: 12px;
    height: 16px;
    margin-top: 0;
    margin-bottom: 10px;
    align-self: flex-start;
    -unity-font-style: italic;
}
