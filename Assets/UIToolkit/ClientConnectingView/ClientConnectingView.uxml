<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UIToolkit/UnityStyleSheet.uss?fileID=7433441132597879392&amp;guid=819e6491a1421a14db87a36e0c93b136&amp;type=3#UnityStyleSheet" />
    <ui:VisualElement name="matchmaker" style="align-items: center; justify-content: center; flex-grow: 1; -unity-background-scale-mode: scale-and-crop;">
        <!-- Dark semi-transparent backdrop panel -->
        <ui:VisualElement name="connectingPanel" style="align-items: center; justify-content: center; background-color: rgba(0, 0, 0, 0.85); border-top-left-radius: 8px; border-top-right-radius: 8px; border-bottom-left-radius: 8px; border-bottom-right-radius: 8px; padding-left: 60px; padding-right: 60px; padding-top: 40px; padding-bottom: 40px; border-left-color: rgba(100, 120, 80, 0.6); border-right-color: rgba(100, 120, 80, 0.6); border-top-color: rgba(100, 120, 80, 0.6); border-bottom-color: rgba(100, 120, 80, 0.6); border-left-width: 2px; border-right-width: 2px; border-top-width: 2px; border-bottom-width: 2px; min-width: 550px;">
            <!-- SoF2 Logo -->
            <ui:VisualElement name="logoContainer" style="align-items: center; margin-bottom: 20px;">
                <ui:VisualElement name="sof2Logo" style="width: 320px; height: 160px; -unity-background-scale-mode: scale-to-fit;" />
            </ui:VisualElement>
            <!-- Divider line -->
            <ui:VisualElement name="dividerTop" style="height: 1px; width: 100%; background-color: rgba(100, 120, 80, 0.5); margin-bottom: 25px;" />
            <!-- Join Server Icon + Title -->
            <ui:VisualElement name="titleRow" style="flex-direction: row; align-items: center; justify-content: center; margin-bottom: 10px;">
                <ui:VisualElement name="joinIcon" style="width: 48px; height: 48px; -unity-background-scale-mode: scale-to-fit; margin-right: 15px;" />
                <ui:Label text="Connecting" name="titleLabel" style="font-size: 52px; color: rgb(200, 220, 180); -unity-font-style: bold; letter-spacing: 4px;" />
            </ui:VisualElement>
            <!-- Server Name (QuakeColorLabel placeholder - replaced at runtime) -->
            <ui:Label text="" name="serverNameLabel" style="font-size: 30px; margin-bottom: 6px; height: 28px; align-self: center;" />
            <!-- Server Address -->
            <ui:VisualElement name="serverInfoRow" style="flex-direction: row; align-items: center; justify-content: center; margin-bottom: 25px; margin-top: 5px;">
                <ui:Label text="127.0.0.1:7777" name="serverAddressLabel" style="font-size: 20px; color: rgb(140, 160, 120);" />
            </ui:VisualElement>
            <!-- Divider line -->
            <ui:VisualElement name="dividerMid" style="height: 1px; width: 80%; background-color: rgba(100, 120, 80, 0.3); margin-bottom: 20px;" />
            <!-- Loading indicator with bullet + clip -->
            <ui:VisualElement name="loadingRow" style="flex-direction: row; align-items: center; justify-content: center; margin-bottom: 15px;">
                <ui:VisualElement name="bulletIcon" style="width: 18px; height: 40px; -unity-background-scale-mode: scale-to-fit; margin-right: 6px;" />
                <ui:VisualElement name="clipIcon" style="width: 140px; height: 30px; -unity-background-scale-mode: scale-to-fit;" />
                <ui:VisualElement name="bulletIcon2" style="width: 18px; height: 40px; -unity-background-scale-mode: scale-to-fit; margin-left: 6px;" />
            </ui:VisualElement>
            <!-- Timer -->
            <ui:Label text="00:00" name="timerLabel" style="font-size: 36px; color: rgb(180, 200, 160); margin-bottom: 25px; letter-spacing: 2px;" />
            <!-- Divider line -->
            <ui:VisualElement name="dividerBottom" style="height: 1px; width: 100%; background-color: rgba(100, 120, 80, 0.5); margin-bottom: 20px;" />
            <!-- Cancel Button -->
            <ui:Button text="Cancel" display-tooltip-when-elided="true" name="quitButton" class="button" style="width: 300px; height: 60px; font-size: 28px; background-color: rgba(80, 40, 40, 0.7); border-left-color: rgba(180, 80, 80, 0.5); border-right-color: rgba(180, 80, 80, 0.5); border-top-color: rgba(180, 80, 80, 0.5); border-bottom-color: rgba(180, 80, 80, 0.5); border-left-width: 1px; border-right-width: 1px; border-top-width: 1px; border-bottom-width: 1px; border-top-left-radius: 4px; border-top-right-radius: 4px; border-bottom-left-radius: 4px; border-bottom-right-radius: 4px;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
