* {
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
}

.button {
    transition-duration: 0.1s;
    transition-timing-function: ease-out;
    opacity: 1;
    height: 80px;
    font-size: 36px;
    width: 450px;
    margin-top: 5px;
    margin-bottom: 5px;
}

.button:hover {
    translate: -1px -1px;
}

.button:active {
    translate: 1px 1px;
}

.background {
    background-color: rgb(40, 40, 40);
    border-top-left-radius: 7px;
    border-bottom-left-radius: 7px;
    border-top-right-radius: 7px;
    border-bottom-right-radius: 7px;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 10px;
    padding-bottom: 10px;
}

.unity-text-field {
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 3px;
    padding-right: 3px;
    padding-top: 0;
    padding-bottom: 0;
    font-size: 30px;
    width: 450px;
    height: 45px;
    justify-content: space-between;
    -unity-text-align: middle-left;
    align-items: auto;
    align-self: center;
    flex-direction: row;
}

.unity-text-field__input {
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    border-top-left-radius: 5px;
    border-bottom-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 0;
    padding-bottom: 0;
    background-color: rgba(0, 0, 0, 0.5);
    -unity-text-align: middle-left;
    color: rgb(213, 236, 255);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    align-self: flex-end;
    align-items: flex-end;
    max-width: 100%;
    min-width: 100%;
}

.unity-slider__label {
    -unity-font-style: bold;
    font-size: 20px;
    margin-left: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    margin-right: 10px;
}

.unity-base-slider .unity-base-slider__dragger {
    height: 22px;
    justify-content: center;
    border-top-left-radius: 5px;
    border-bottom-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    width: 11px;
    background-color: rgb(82, 125, 175);
    border-left-color: rgb(131, 180, 222);
    border-right-color: rgb(131, 180, 222);
    border-top-color: rgb(131, 180, 222);
    border-bottom-color: rgb(131, 180, 222);
    border-left-width: 3px;
    border-right-width: 3px;
    border-top-width: 3px;
    border-bottom-width: 3px;
    top: 14px;
    margin-left: 4px;
    margin-right: 4px;
}

.unity-base-slider .unity-base-slider__tracker {
    height: 16px;
    border-top-left-radius: 8px;
    border-bottom-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
    border-left-color: rgb(82, 125, 175);
    border-right-color: rgb(82, 125, 175);
    border-top-color: rgb(82, 125, 175);
    border-bottom-color: rgb(82, 125, 175);
    border-left-width: 3px;
    border-right-width: 3px;
    border-top-width: 3px;
    border-bottom-width: 3px;
    background-color: rgb(45, 81, 123);
    top: 8px;
    transition-duration: 0.1s;
    transition-timing-function: ease-out;
}

.unity-base-slider .unity-base-slider__tracker:hover {
    height: 16px;
    border-left-color: rgb(131, 180, 222);
    border-right-color: rgb(131, 180, 222);
    border-top-color: rgb(131, 180, 222);
    border-bottom-color: rgb(131, 180, 222);
    background-color: rgb(56, 101, 153);
    top: 8px;
}

.title {
    top: auto;
    align-self: center;
    font-size: 140px;
    margin-bottom: 50px;
}

.button-disabled {
    opacity: 0.5;
    background-color: rgb(60, 60, 60);
    border-left-color: rgb(80, 80, 80);
    border-right-color: rgb(80, 80, 80);
    border-top-color: rgb(80, 80, 80);
    border-bottom-color: rgb(80, 80, 80);
}

.button-disabled:hover {
    background-color: rgb(60, 60, 60);
    border-left-color: rgb(80, 80, 80);
    border-right-color: rgb(80, 80, 80);
    border-top-color: rgb(80, 80, 80);
    border-bottom-color: rgb(80, 80, 80);
    translate: 0 0;
}

.button-disabled:active {
    background-color: rgb(60, 60, 60);
    border-left-color: rgb(80, 80, 80);
    border-right-color: rgb(80, 80, 80);
    border-top-color: rgb(80, 80, 80);
    border-bottom-color: rgb(80, 80, 80);
    translate: 0 0;
}

.login-modal-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.7);
    justify-content: center;
    align-items: center;
    display: flex;
}

.login-modal-content {
    justify-content: center;
    align-items: center;
    flex-direction: column;
    margin-top: 20px;
}

.spinner {
    width: 80px;
    height: 80px;
    border-top-width: 4px;
    border-right-width: 4px;
    border-bottom-width: 4px;
    border-left-width: 4px;
    border-top-left-radius: 50%;
    border-top-right-radius: 50%;
    border-bottom-right-radius: 50%;
    border-bottom-left-radius: 50%;
    border-top-color: rgb(82, 125, 175);
    border-right-color: rgba(82, 125, 175, 0.3);
    border-bottom-color: rgba(82, 125, 175, 0.3);
    border-left-color: rgba(82, 125, 175, 0.3);
    transition-duration: 1s;
    transition-timing-function: linear;
}

.spinner.spinning {
    rotate: 640deg;
}

.login-modal-text {
    color: rgb(213, 236, 255);
    font-size: 24px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.logout-modal-overlay {
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.7);
}

.logout-modal-content {
    background-image: resource('uQuake/gfx/menus/scoreboard/scorelineheader');
    background-color: rgba(30, 30, 30, 0.95);
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
    border-left-color: rgb(131, 180, 222);
    border-right-color: rgb(131, 180, 222);
    border-top-color: rgb(131, 180, 222);
    border-bottom-color: rgb(131, 180, 222);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    min-width: 600px;
}

.button {
    background-color: rgba(2, 2, 2, 0);
    border-left-color: rgba(204, 204, 204, 0);
    border-right-color: rgba(204, 204, 204, 0);
    border-top-color: rgba(204, 204, 204, 0);
    border-bottom-color: rgba(204, 204, 204, 0);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
    width: 450px;
    height: 80px;
}
