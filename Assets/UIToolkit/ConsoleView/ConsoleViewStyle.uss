.console-root {
    width: 100%;
    height: 100%;
    position: absolute;
    top: 0;
    left: 0;
    overflow: hidden;

    background-size: cover;
    background-position: center;
}

.terminal-panel {
    width: 100%;
    max-width: 95%;
    height: 80%;
    margin-left: auto;
    margin-right: auto;
    margin-top: 5%;
    border-radius: 8px;
    background-color: rgba(6,10,14,0.65);
    padding: 18px;
    position: relative;
    overflow: hidden;
}

.console-output {
    flex-grow: 1;
    margin-bottom: 12px;
    background-color: transparent;
    color: white;
    font-size: 14px;
}

.console-input, .console-output {
    height: 34px;
    border-radius: 4px;
    border-width: 0;
    padding-left: 10px;
    padding-right: 10px;
    font-size: 28px;
    align-self: stretch;
}

.console-input > #unity-text-input {
    background-color: rgba(255, 255, 255, 0);
}

.glowline {
    width: 100%;
    height: 6px;
    background-size: cover;
    background-repeat: no-repeat;
    opacity: 0.15;
}

.glowline-wide {
    width: 100%;
    height: 18px;
    background-size: cover;
    background-repeat: no-repeat;
    opacity: 0.09;
}
