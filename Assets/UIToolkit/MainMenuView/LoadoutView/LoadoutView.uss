/* ========================================
   LoadoutView Stylesheet
   Top bar (name+id / tabs)
   Preview wrapper with overlays
   ======================================== */

.loadout-root {
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: column;
    min-height: 0;
}

/* ===== TOP BAR ===== */
.loadout-top-bar {
    flex-shrink: 0;
    height: 36px;
    flex-direction: row;
    align-items: center;
    padding-left: 16px;
    padding-right: 16px;
    background-color: rgba(8, 12, 22, 0.7);
}

.loadout-top-left {
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
}

.loadout-player-name {
    font-size: 16px;
    color: rgb(210, 225, 245);
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.loadout-player-id {
    font-size: 10px;
    color: rgb(100, 120, 140);
}

/* ===== ICON TAB ROW (SoF2-style, own row) ===== */
.loadout-icon-row {
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 8px;
    padding-bottom: 8px;
}

/* ===== ICON TABS (SoF2-style) ===== */
.loadout-icon-tab {
    width: 86px;
    height: 86px;
    margin-left: 4px;
    margin-right: 4px;
    background-color: rgba(20, 28, 40, 0.85);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-color: rgba(60, 80, 110, 0.6);
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgba(180, 200, 220, 0.7);
    transition-duration: 0.12s;
    transition-timing-function: ease-out;
}

.loadout-icon-tab:hover {
    background-color: rgba(40, 55, 80, 0.9);
    border-color: rgba(100, 150, 210, 0.6);
    -unity-background-image-tint-color: rgb(255, 255, 255);
    scale: 1.05;
}

.loadout-icon-tab-active {
    background-color: rgba(50, 75, 110, 0.95);
    border-color: rgba(100, 170, 240, 0.7);
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

.loadout-icon-tab-disabled {
    opacity: 0.55;
}

.loadout-icon-tab-disabled:hover {
    background-color: rgba(20, 28, 40, 0.85);
    border-color: rgba(80, 110, 150, 0.4);
    -unity-background-image-tint-color: rgba(180, 200, 220, 0.7);
    scale: 1;
}

.loadout-icon-tab-player {
}

.loadout-icon-tab-scale {
}

.loadout-icon-tab-misc {
}

.loadout-icon-tab-back {
}

.loadout-icon-tab-keys {
}

.loadout-icon-tab-display {
}

.loadout-icon-tab-sound {
}

.loadout-icon-tab-network {
}

/* ===== CONTENT (two columns: preview left, info right) ===== */
.loadout-content {
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: row;
    min-height: 0;
}

/* ===== PREVIEW WRAPPER (left column, ~60%) ===== */
.loadout-preview-wrapper {
    flex-grow: 0;
    flex-shrink: 0;
    flex-basis: 60%;
    min-height: 0;
    position: relative;
}

.loadout-preview-area {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* ===== PLAYER NAME OVERLAY ===== */
.loadout-player-name-overlay {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 8%;
    justify-content: center;
    align-items: center;
    flex-direction: row;
    align-self: center;
}

/* ===== NAV BUTTONS (absolute, close to character) ===== */
.loadout-nav-btn {
    position: absolute;
    top: 50%;
    margin-top: -24px;
    width: 48px;
    height: 48px;
    justify-content: center;
    align-items: center;
    font-size: 22px;
    color: rgb(200, 215, 235);
    background-color: rgba(20, 30, 50, 0.6);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-color: rgba(80, 120, 170, 0.4);
    transition-duration: 0.12s;
    transition-timing-function: ease-out;
}

.loadout-nav-btn:hover {
    background-color: rgba(40, 60, 100, 0.7);
    border-color: rgba(100, 160, 230, 0.6);
    color: rgb(255, 255, 255);
    scale: 1.08;
}

.loadout-nav-btn:active {
    background-color: rgba(30, 50, 80, 0.8);
    scale: 0.95;
}

.loadout-nav-btn-left {
    left: 22%;
}

.loadout-nav-btn-right {
    right: 22%;
}

/* ===== RIGHT PANEL (SoF2-style info) ===== */
.loadout-right-panel {
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: column;
    justify-content: flex-start;
    padding-left: 24px;
    padding-right: 28px;
    padding-top: 16px;
}

.loadout-section-label {
    font-size: 28px;
    color: rgba(180, 200, 220, 0.6);
    -unity-font-style: italic;
    margin-bottom: 6px;
}

.loadout-section-label-gap {
    margin-top: 28px;
}

.loadout-display-name-input {
    flex-shrink: 0;
    width: 100%;
}

.loadout-display-name-input > .unity-text-field__label {
    display: none;
}

.loadout-display-name-input > .unity-text-field__input {
    background-color: rgba(10, 15, 25, 0.8);
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-left-radius: 3px;
    border-bottom-right-radius: 3px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-color: rgba(60, 90, 130, 0.5);
    color: rgba(0, 0, 0, 0);
    min-height: 42px;
    --unity-cursor-color: rgba(0, 0, 0, 0);
}

.loadout-display-name-input .unity-text-element {
    color: rgba(0, 0, 0, 0) !important;
    font-size: 1px !important;
}

.loadout-skin-info {
    flex-direction: column;
    align-items: flex-start;
}

.loadout-skin-name {
    font-size: 28px;
    color: rgb(230, 240, 255);
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.loadout-skin-rarity {
    font-size: 18px;
    color: rgb(120, 200, 120);
    letter-spacing: 2px;
    margin-top: 4px;
}

.loadout-skin-description {
    font-size: 18px;
    color: rgb(150, 165, 185);
    margin-top: 4px;
}

/* ===== HIDDEN (for C# compat) ===== */
.loadout-hidden {
    display: none;
}

/* ===== SKIN THUMBNAIL LIST (SoF2-style horizontal) ===== */
.loadout-skin-list {
    flex-shrink: 0;
    flex-grow: 0;
    width: 100%;
    margin-bottom: 46px;
}

/* Custom HorizontalScrollView: viewport clips content */
.loadout-skin-list > .horizontal-scroll-view__viewport {
    overflow: hidden;
    flex-grow: 1;
    flex-shrink: 1;
    height: 228px;
}

/* Content container: row layout */
.loadout-skin-list > .horizontal-scroll-view__viewport > .horizontal-scroll-view__content-container {
    flex-direction: row;
    align-items: flex-start;
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
}

.loadout-skin-thumbnail {
    width: 100px;
    height: 200px;
    margin-right: 4px;
    margin-top: 4px;
    margin-left: 4px;
    margin-right: 4px;
    margin-bottom: 20px;
    flex-shrink: 0;
    background-color: rgba(10, 15, 25, 0.8);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-color: rgba(60, 80, 110, 0.5);
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-left-radius: 3px;
    border-bottom-right-radius: 3px;
    -unity-background-scale-mode: scale-to-fit;
    transition-duration: 0.1s;
    transition-timing-function: ease-out;
}

.loadout-skin-thumbnail:hover {
    border-color: rgba(100, 170, 240, 0.7);
    scale: 1.05;
}

.loadout-skin-thumbnail-selected {
    border-color: rgba(100, 170, 240, 0.9);
    border-left-width: 3px;
    border-right-width: 3px;
    border-top-width: 3px;
    border-bottom-width: 3px;
    background-color: rgba(30, 50, 80, 0.9);
}

/* ===== SoF2-style scrollbar (custom HorizontalScrollView) ===== */

/* Scrollbar row layout */
.loadout-skin-list > .horizontal-scroll-view__scrollbar {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    height: 46px;
}

/* Left arrow */
.loadout-skin-list .horizontal-scroll-view__arrow-left {
    width: 46px;
    height: 46px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
    background-color: rgba(0, 0, 0, 0);
}

.loadout-skin-list .horizontal-scroll-view__arrow-left:hover {
    scale: 1.1;
}

/* Right arrow */
.loadout-skin-list .horizontal-scroll-view__arrow-right {
    width: 46px;
    height: 46px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
    background-color: rgba(0, 0, 0, 0);
}

.loadout-skin-list .horizontal-scroll-view__arrow-right:hover {
    scale: 1.1;
}

/* Track */
.loadout-skin-list .horizontal-scroll-view__track {
    flex-grow: 1;
    height: 100%;
    position: relative;
    -unity-background-scale-mode: stretch-to-fill;
    background-color: rgba(0, 0, 0, 0);
}

/* Thumb */
.loadout-skin-list .horizontal-scroll-view__thumb {
    height: 100%;
    position: absolute;
    top: 0;
    min-width: 40px;
    -unity-background-scale-mode: stretch-to-fill;
    background-color: rgb(0, 0, 0);
}
