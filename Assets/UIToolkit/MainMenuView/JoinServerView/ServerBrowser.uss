/* ── SoF2 Authentic Server Browser Styles ─────────────────── */
/* Eingebettet in contentBackground (MainMenuView) — kein eigener Background */

/* ── Root: fuellt contentBackground zu 100% ──────────────── */

.sof2-browser-root {
    width: 100%;
    height: 95%;
    flex-direction: column;
    padding: 8px 12px;
}

/* ── Scanline CRT Overlay ────────────────────────────────── */

.sof2-scanline-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: rgba(255, 255, 255, 0.04);
}

/* ── Top Bar: Buttons + Filter Info ───────────────────────── */

.sof2-top-bar {
    flex-direction: row;
    align-items: center;
    height: 60px;
    flex-shrink: 0;
    margin-bottom: 4px;
    border-bottom-width: 2px;
    border-color: rgba(30, 40, 15, 0.8);
}

.sof2-top-bar-left {
    flex-direction: row;
    align-items: center;
}

.sof2-top-bar-right {
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
}

/* ── Selected Server Display (top bar) ───────────────────── */

.sof2-selected-server {
    flex-grow: 1;
    flex-shrink: 1;
    -unity-text-align: middle-center;
    font-size: 16px;
    color: rgb(220, 245, 180);
    -unity-font-style: bold;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.8);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    margin: 0;
    padding: 0 8px;
}

/* ── Filter Info (mitte) ─────────────────────────────────── */

.sof2-top-bar-info {
    flex-grow: 1;
    flex-direction: row;
    padding-left: 16px;
    padding-right: 16px;
}

.sof2-info-column {
    flex-direction: column;
    margin-right: 32px;
}

.sof2-info-label {
    font-size: 14px;
    color: rgb(180, 210, 140);
    -unity-font-style: bold;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.8);
    margin: 0;
    padding: 0;
}

/* ── SoF2 Submenu Buttons ────────────────────────────────── */

.sof2-submenu-button {
    width: 160px;
    height: 50px;
    margin-left: 4px;
    margin-right: 4px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(160, 200, 110);
    transition-duration: 0.12s;
    transition-property: -unity-background-image-tint-color;
    padding: 0;
}

.sof2-submenu-button:hover {
    -unity-background-image-tint-color: rgb(230, 255, 180);
}

.sof2-submenu-button:active {
    -unity-background-image-tint-color: rgb(100, 130, 60);
}

.sof2-join-button {
    width: 54px;
    height: 54px;
}

/* ── Column Headers ──────────────────────────────────────── */

.server-row {
    flex-direction: row;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    min-height: 34px;
    align-items: center;
}

.server-header-row {
    background-color: rgba(40, 60, 20, 0.65);
    border-bottom-width: 2px;
    border-bottom-color: rgba(30, 40, 15, 0.8);
    border-top-width: 2px;
    border-top-color: rgba(30, 40, 15, 0.8);
    min-height: 38px;
    flex-shrink: 0;
    margin-right: 30px;
}

.server-header-row > .server-cell {
    font-size: 18px;
    color: rgb(180, 210, 140);
    -unity-font-style: bold;
}

/* ── Bordered cells (thick SoF2 original style) ─────────── */

.server-cell-bordered {
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-color: rgba(30, 40, 15, 0.8);
    padding-top: 4px;
    padding-bottom: 4px;
}

/* ── Data Rows ───────────────────────────────────────────── */

.server-row-entry {
    background-color: rgba(0, 0, 0, 0);
    border-bottom-width: 1px;
    border-bottom-color: rgba(30, 40, 15, 0.6);
    transition-duration: 0.1s;
    transition-property: background-color;
}

.server-row-entry:hover {
    background-color: rgba(60, 100, 30, 0.45);
}

.server-row-selected {
    background-color: rgba(100, 150, 50, 0.4);
    border-left-width: 3px;
    border-left-color: rgb(160, 210, 70);
}

.server-row-selected:hover {
    background-color: rgba(100, 150, 50, 0.5);
}

/* ── Server List (scrollable with world map bg) ──────────── */

.server-list-scroll {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 0;
    border-bottom-width: 2px;
    border-color: rgba(30, 40, 15, 0.8);
    -unity-background-scale-mode: scale-and-crop;
    -unity-background-image-tint-color: rgba(255, 255, 255, 0.12);
    overflow: hidden;
}

/* ── Scrollbar Styling (SoF2 Custom Textures) ───────────── */

.server-list-scroll .unity-scroller--vertical {
    width: 28px;
    border-left-width: 2px;
    border-left-color: rgba(30, 40, 15, 0.8);
}

.server-list-scroll .unity-scroller--vertical .unity-base-slider__tracker {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    -unity-background-scale-mode: stretch-to-fill;
}

.server-list-scroll .unity-scroller--vertical .unity-base-slider__dragger {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
    min-height: 30px;
    -unity-background-scale-mode: stretch-to-fill;
}

.server-list-scroll .unity-scroller--vertical .unity-base-slider__dragger:hover {
    -unity-background-image-tint-color: rgb(220, 240, 200);
}

.server-list-scroll .unity-scroller--vertical .unity-repeat-button {
    width: 28px;
    height: 28px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(255, 255, 255);
    margin-top: 4px;
    margin-bottom: 4px;
}

.server-list-scroll .unity-scroller--vertical .unity-repeat-button:hover {
    -unity-background-image-tint-color: rgb(220, 255, 180);
    scale: 1.05;
}

/* ── Cell Styles ─────────────────────────────────────────── */

.server-cell {
    font-size: 18px;
    overflow: hidden;
    -unity-text-align: middle-left;
    padding-left: 6px;
    padding-right: 6px;
    color: rgb(200, 230, 170);
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.7);
    border-right-width: 2px;
    border-right-color: rgba(30, 40, 15, 0.6);
}

.server-cell-lock {
    width: 34px;
    height: 28px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(30, 30, 20);
    padding-left: 4px;
    padding-right: 2px;
}

.server-cell-name {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 100px;
}

.server-cell-map {
    width: 280px;
    flex-shrink: 0;
}

.server-cell-players {
    width: 120px;
    flex-shrink: 0;
    -unity-text-align: middle-left;
}

.server-cell-gametype {
    width: 180px;
    -unity-text-align: middle-center;
    flex-shrink: 0;
}

.server-cell-ping {
    width: 85px;
    flex-shrink: 0;
    -unity-text-align: middle-right;
    border-right-width: 0;
}

/* ── Status Label ────────────────────────────────────────── */

.sof2-status {
    font-size: 12px;
    -unity-text-align: middle-center;
    color: rgb(160, 190, 120);
    margin-top: 4px;
    height: 28px;
    flex-shrink: 0;
    font-size: 18px;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.7);
}

.sof2-submenu-button:disabled {
    -unity-background-image-tint-color: rgba(80, 80, 80, 0.4);
}

/* ── Bottom Toolbar (Original SoF2 Text Buttons) ────────── */

.sof2-bottom-toolbar {
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    height: 44px;
    flex-shrink: 0;
    margin-top: 4px;
    padding-left: 2px;
    padding-right: 2px;
}

.sof2-toolbar-button {
    height: 36px;
    min-width: 140px;
    padding-left: 16px;
    padding-right: 16px;
    margin-left: 4px;
    margin-right: 4px;
    background-color: rgba(30, 45, 15, 0.5);
    border-width: 2px;
    border-color: rgba(30, 40, 15, 0.8);
    border-radius: 0;
    font-size: 16px;
    color: rgb(180, 210, 140);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.8);
    transition-duration: 0.12s;
    transition-property: background-color, color;
}

.sof2-toolbar-button:hover {
    background-color: rgba(60, 90, 30, 0.65);
    color: rgb(220, 250, 180);
}

.sof2-toolbar-button:active {
    background-color: rgba(20, 30, 10, 0.7);
    color: rgb(140, 170, 100);
}

.sof2-toolbar-button:disabled {
    background-color: rgba(20, 30, 10, 0.3);
    color: rgba(120, 140, 100, 0.4);
    border-color: rgba(30, 40, 15, 0.4);
}
