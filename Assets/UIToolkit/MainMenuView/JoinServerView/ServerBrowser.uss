/* ── SoF2 Authentic Server Browser Styles ─────────────────── */
/* Eingebettet in contentBackground (MainMenuView) — kein eigener Background */

/* ── Root: fuellt contentBackground zu 100% ──────────────── */

.sof2-browser-root {
    width: 100%;
    height: 100%;
    flex-direction: column;
    padding: 8px 12px;
}

/* ── Scanline CRT Overlay ────────────────────────────────── */

.sof2-scanline-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: rgba(255, 255, 255, 0.04);
}

/* ── Top Bar: Buttons + Title ────────────────────────────── */

.sof2-top-bar {
    flex-direction: row;
    align-items: center;
    height: 60px;
    flex-shrink: 0;
    margin-bottom: 4px;
}

.sof2-top-bar-left {
    flex-direction: row;
    align-items: center;
}

.sof2-top-bar-right {
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
}

/* ── Title ───────────────────────────────────────────────── */

.sof2-title {
    flex-grow: 1;
    font-size: 22px;
    -unity-text-align: middle-center;
    color: rgb(200, 230, 150);
    -unity-font-style: bold;
    text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.9);
}

/* ── SoF2 Submenu Buttons ────────────────────────────────── */

.sof2-submenu-button {
    width: 160px;
    height: 50px;
    margin-left: 4px;
    margin-right: 4px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(160, 200, 110);
    transition-duration: 0.12s;
    transition-property: -unity-background-image-tint-color;
    padding: 0;
}

.sof2-submenu-button:hover {
    -unity-background-image-tint-color: rgb(230, 255, 180);
}

.sof2-submenu-button:active {
    -unity-background-image-tint-color: rgb(100, 130, 60);
}

.sof2-join-button {
    width: 54px;
    height: 54px;
}

/* ── Column Headers ──────────────────────────────────────── */

.server-row {
    flex-direction: row;
    padding-left: 0;
    padding-right: 0;
    padding-top: 4px;
    padding-bottom: 4px;
    min-height: 34px;
    align-items: center;
}

.server-header-row {
    background-color: rgba(40, 60, 20, 0.65);
    border-bottom-width: 2px;
    border-color: rgba(140, 180, 80, 0.5);
    min-height: 38px;
    flex-shrink: 0;
}

.server-header-row > .server-cell {
    font-size: 18px;
    color: rgb(180, 210, 140);
    -unity-font-style: bold;
}

/* ── Data Rows ───────────────────────────────────────────── */

.server-row-entry {
    background-color: rgba(0, 0, 0, 0);
    border-bottom-width: 1px;
    border-color: rgba(120, 160, 80, 0.15);
    transition-duration: 0.1s;
    transition-property: background-color;
}

.server-row-entry:hover {
    background-color: rgba(60, 100, 30, 0.45);
}

.server-row-selected {
    background-color: rgba(100, 150, 50, 0.4);
    border-left-width: 3px;
    border-left-color: rgb(160, 210, 70);
}

.server-row-selected:hover {
    background-color: rgba(100, 150, 50, 0.5);
}

/* ── Server List (scrollable with world map bg) ──────────── */

.server-list-scroll {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 0;
    border-bottom-width: 1px;
    border-color: rgba(140, 180, 80, 0.35);
    -unity-background-scale-mode: scale-and-crop;
    -unity-background-image-tint-color: rgba(255, 255, 255, 0.12);
    overflow: hidden;
}

/* ── Scrollbar Styling (SoF2 Look) ──────────────────────── */

.server-list-scroll .unity-scroller--vertical {
    width: 14px;
}

.server-list-scroll .unity-scroller--vertical .unity-base-slider__tracker {
    background-color: rgba(30, 45, 15, 0.6);
    border-width: 1px;
    border-color: rgba(100, 140, 60, 0.3);
}

.server-list-scroll .unity-scroller--vertical .unity-base-slider__dragger {
    background-color: rgba(80, 120, 40, 0.7);
    border-width: 1px;
    border-color: rgba(140, 180, 70, 0.5);
    border-radius: 2px;
}

.server-list-scroll .unity-scroller--vertical .unity-base-slider__dragger:hover {
    background-color: rgba(100, 150, 50, 0.85);
}

.server-list-scroll .unity-scroller--vertical .unity-repeat-button {
    background-color: rgba(50, 75, 25, 0.6);
    border-width: 1px;
    border-color: rgba(100, 140, 60, 0.4);
    -unity-background-image-tint-color: rgb(160, 200, 100);
}

/* ── Cell Styles ─────────────────────────────────────────── */

.server-cell {
    font-size: 18px;
    overflow: hidden;
    -unity-text-align: middle-left;
    padding-left: 6px;
    padding-right: 6px;
    color: rgb(200, 230, 170);
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.7);
    border-right-width: 1px;
    border-color: rgba(120, 160, 80, 0.25);
}

.server-cell-lock {
    width: 30px;
    height: 24px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(220, 200, 100);
    padding-left: 4px;
    padding-right: 2px;
}

.server-cell-name {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 140px;
}

.server-cell-map {
    width: 130px;
    flex-shrink: 0;
}

.server-cell-players {
    width: 55px;
    flex-shrink: 0;
    -unity-text-align: middle-center;
}

.server-cell-gametype {
    width: 70px;
    flex-shrink: 0;
}

.server-cell-ping {
    width: 45px;
    flex-shrink: 0;
    -unity-text-align: middle-center;
    border-right-width: 0;
}

/* ── Status Label ────────────────────────────────────────── */

.sof2-status {
    font-size: 12px;
    -unity-text-align: middle-center;
    color: rgb(160, 190, 120);
    margin-top: 4px;
    height: 18px;
    flex-shrink: 0;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.7);
}

.sof2-submenu-button:disabled {
    -unity-background-image-tint-color: rgba(80, 80, 80, 0.4);
}
