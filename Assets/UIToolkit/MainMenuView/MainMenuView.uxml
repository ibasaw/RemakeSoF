<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UIToolkit/UnityStyleSheet.uss?fileID=7433441132597879392&amp;guid=819e6491a1421a14db87a36e0c93b136&amp;type=3#UnityStyleSheet" />
    <ui:VisualElement name="mainMenu" style="justify-content: space-between; align-items: center; width: 100%; height: 100%;">
        <ui:VisualElement name="contentBackground" style="flex-grow: 1; width: 90%; flex-shrink: 1; align-items: stretch; justify-content: flex-start; margin-top: 70px; margin-bottom: 140px;">
            <ui:VisualElement name="myContainerTest" style="flex-grow: 1; background-size: 100% 100%;" />
        </ui:VisualElement>
        <ui:VisualElement name="bottomButtonGroup" style="flex-grow: 1; width: 760px; height: 75px; flex-shrink: 1; flex-direction: row; position: absolute; bottom: 65px; left: 565px; flex-basis: auto; justify-content: center; align-items: flex-start; align-content: flex-start; align-self: auto;">
            <ui:Button name="joinServerButton" style="background-color: rgba(188, 188, 188, 0); -unity-background-image-tint-color: rgb(111, 245, 0); width: 20%; height: 100%; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0;" />
            <ui:Button name="createServerButton" style="background-color: rgba(188, 188, 188, 0); -unity-background-image-tint-color: rgb(111, 245, 0); width: 20%; height: 100%; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0;" />
            <ui:Button name="loadoutButton" tooltip="Tester" style="background-color: rgba(188, 188, 188, 0); -unity-background-image-tint-color: rgb(111, 245, 0); width: 20%; background-size: 100% 100%; height: 100%; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0;" />
            <ui:Button name="optionsButton" style="background-color: rgba(188, 188, 188, 0); -unity-background-image-tint-color: rgb(111, 245, 0); width: 20%; height: 100%; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0;" />
            <ui:Button name="logoutButton" style="background-color: rgba(188, 188, 188, 0); -unity-background-image-tint-color: rgb(111, 245, 0); width: 20%; height: 100%; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
