/* ===== HUD Overlay (always visible, top-left like SoF2) ===== */
.chat-hud-overlay {
    position: absolute;
    top: 16px;
    left: 16px;
    width: 620px;
    flex-direction: column;
    overflow: hidden;
}

.chat-hud-message {
    font-size: 18px;
    color: white;
    margin-bottom: 2px;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.8);
}

/* ===== Full Chat Panel (toggled with T) ===== */
.chat-root {
    position: absolute;
    top: 16px;
    left: 16px;
    width: 650px;
    height: 340px;
}

.chat-panel {
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.6);
    border-radius: 4px;
    padding: 8px;
    flex-direction: column;
}

.chat-output {
    flex-grow: 1;
    margin-bottom: 4px;
    background-color: transparent;
    color: white;
    font-size: 16px;
}

.chat-input {
    height: 42px;
    border-radius: 2px;
    border-width: 0;
    padding-left: 8px;
    padding-right: 8px;
    font-size: 18px;
    color: white;
    background-color: rgba(255, 255, 255, 0.1);
    overflow: visible;
}

.chat-input > #unity-text-input {
    background-color: rgba(255, 255, 255, 0);
    color: white;
    overflow: visible;
}
