    "Gore": {
        "_comments": [
            "Flags",
            "NoChildSurfacesOn = ignore any commands in children for turning surfaces on",
            "NoChildFX = ignore any commands in children for spawning FX",
            "NoChildChunks = ignore any commands in children for spawning chunks",
            "NoChildBoltOns = ignore any commands in the children for adding bolt on models",
            "Abbreviations (assuming Primary is the Right side)",
            "<PL> = Primary Long, such as 'right'",
            "<PS> = Primary Short, such as 'r'",
            "<OL> = Opposite Long, such as 'left'",
            "<OS> = Opposite Short, such as 'l'",
            "gore_area format",
            "Location = public location of this area",
            "Flags = various flags that control this area",
            "Surfaces_Off = list of surfaces that should be turned off in the original model to remove this area",
            "Surfaces_On = list of surfaces that should be turned on in the original model to cap off the removal",
            "Children = list of children underneath this area",
            "Chunk = definition of a chunk that should fly off",
            "FX = definition of an effect that should be played",
            "BoltOn = definition of bolt on models",
            "Name = name of the gore_piece definition",
            "Bolt = optional bolt location"
        ],
