gfx/decals/impact/wood
{
	polygonOffset
	q3map_nolightmap
	sort	decal
	cull	disable
    {
        clampmap gfx/decals/impact/wood
        blendFunc GL_SRC_ALPHA GL_ONE_MINUS_SRC_ALPHA
        alphaGen vertex
    }
}

