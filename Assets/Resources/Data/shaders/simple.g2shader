gfx/menus/hud/weapon_icons/ak74_icon_simple
{
	nopicmip
	nomipmaps
	notc
	q3map_nolightmap
	q3map_onlyvertexlighting
    {
        map gfx/menus/hud/weapon_icons/ak74_icon
        blendFunc GL_SRC_ALPHA GL_ONE_MINUS_SRC_ALPHA
        rgbGen vertex
    }
}

