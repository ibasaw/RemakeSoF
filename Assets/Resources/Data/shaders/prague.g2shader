textures/prague/hedge_1_projClip
{
	qer_editorimage	textures/prague/hedge_1
	surfaceparm	slime
	q3map_material	GreenLeaves
	cull	disable
    {
        map textures/prague/hedge_1
        alphaFunc GE128
        blendFunc GL_ZERO GL_ZERO
        depthWrite
    }
    {
        map $lightmap
        depthFunc equal
    }
    {
        map textures/prague/hedge_1
        blendFunc GL_DST_COLOR GL_ZERO
        depthFunc equal
    }
}

