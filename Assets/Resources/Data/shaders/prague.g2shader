textures/prague/woodtrim
{
	q3map_material	SolidWood
    {
        map $lightmap
    }
    {
        map textures/prague/woodtrim
        blendFunc GL_DST_COLOR GL_ZERO
    }
    {
        map textures/common/env_chrome
        blendFunc GL_SRC_ALPHA GL_ONE_MINUS_SRC_ALPHA
        alphaGen const 0.2
        tcGen environment
    }
    {
        map textures/prague/woodtrim_mask
        blendFunc GL_SRC_ALPHA GL_ONE_MINUS_SRC_ALPHA
    }
}

