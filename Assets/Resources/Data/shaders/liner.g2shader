textures/liner/door_liner
{
	q3map_material	HollowMetal
	cull	disable
    {
        map textures/liner/door_liner
        alphaFunc GE128
        blendFunc GL_SRC_ALPHA GL_ZERO
        depthWrite
    }
    {
        map $lightmap
        blendFunc GL_ONE GL_ZERO
        depthFunc equal
    }
    {
        map textures/liner/door_liner
        blendFunc GL_DST_COLOR GL_ZERO
        depthFunc equal
    }
}

