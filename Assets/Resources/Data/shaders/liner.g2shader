    }
    {
        map textures/liner/map_gates_closed
        blendFunc GL_ONE GL_ONE
    }
    {
        map textures/liner/map_gates_blocked
        blendFunc GL_ONE GL_ONE
        rgbGen wave square 0 1 0 2
    }
}

textures/liner/map_gates3
{
	qer_editorimage	textures/liner/map_gates_base
	q3map_material	Plastic
    {
        map $lightmap
    }
    {
        map textures/liner/map_gates_base
        blendFunc GL_DST_COLOR GL_ZERO
    }
    {
        map textures/liner/map_gates_glowpoints
        blendFunc GL_ONE GL_ONE
        rgbGen wave sin 0 1 0 0.5
    }
    {
        map textures/liner/map_gates_open
        blendFunc GL_ONE GL_ONE
    }
}

models/objects/liner/lights/wall_light_bulb
{
	q3map_material	Glass
    {
        map $lightmap
    }
    {
        map models/objects/liner/lights/wall_light_bulb
        blendFunc GL_DST_COLOR GL_ZERO
        rgbGen lightingDiffuse
    }
}

models/objects/liner/lights/wall_light_alpha
{
	q3map_material	Glass
    {
        map models/objects/liner/lights/wall_light_alpha
        alphaFunc GE128
        blendFunc GL_SRC_ALPHA GL_ZERO
        depthWrite
    }
    {
        map $lightmap
        blendFunc GL_ONE GL_ZERO
        depthFunc equal
    }
    {
        map models/objects/liner/lights/wall_light_alpha
        blendFunc GL_DST_COLOR GL_ZERO
        depthFunc equal
    }
}

