textures/liner/sky
{
	q3map_lightimage	textures/colors/blue
	qer_editorimage	textures/colors/blue_light
	q3map_surfacelight	15
	sun 0.75 0.79 1 50 46 40
	surfaceparm	sky
	surfaceparm	noimpact
	surfaceparm	nodraw
	q3map_nolightmap
	skyParms	- 512 -
}

