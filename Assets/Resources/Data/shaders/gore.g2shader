models/characters/gore/new_bullet_1
{
	polygonOffset
	q3map_nolightmap
	q3map_onlyvertexlighting
    {
        clampmap models/characters/gore/gil_bullet_holeF
        blendFunc GL_SRC_ALPHA GL_ONE_MINUS_SRC_ALPHA
        rgbGen lightingDiffuse
    }
    {
        clampmap models/characters/gore/gil_spurt_B
            surfaceSprites effect 0.7 1.0 505 600
			ssVariance .25 .25
            ssFXDuration 365
            ssFXGrow 4.5 10.5
            ssFXAlphaRange 2.0 0.1
			ssGoreCentral .15
			ssSpurt 0 1.25
        blendFunc GL_SRC_ALPHA GL_ONE_MINUS_SRC_ALPHA
    }
    {
        clampmap models/characters/gore/gil_blood_river
            surfaceSprites oriented 1.0 4.0 50 600
			ssVariance .5 .5
			ssGoreCentral .4
			ssSpurtflat 0 1.25
        blendFunc GL_SRC_ALPHA GL_ONE_MINUS_SRC_ALPHA
    }
    {
        clampmap models/characters/gore/gil_blood_1_dropD
            surfaceSprites oriented 1.15 1.15 50 600
			ssVariance .75 .75
			ssGoreCentral .75
			ssFaceflat
        blendFunc GL_SRC_ALPHA GL_ONE_MINUS_SRC_ALPHA
    }
}

