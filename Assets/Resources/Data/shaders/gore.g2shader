models/characters/gore/brain
{
	q3map_material	Flesh
	q3map_nolightmap
	q3map_onlyvertexlighting
    {
        map models/characters/gore/brain/brain
        blendFunc GL_ONE GL_ZERO
        rgbGen lightingDiffuse
    }
}

