    {
        clampmap gfx/misc/jk_fire
            surfaceSprites effect 3.0 3.0 17.8 6000
            ssFXDuration 750
            ssFXGrow 5 5
            ssFXAlphaRange 3.0 0.0
			ssGore
        blendFunc GL_ONE GL_ONE
    }
}

