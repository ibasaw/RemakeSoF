textures/colombia/bamboo_wall
{
// * surfaceparm trans

	q3map_material	HollowWood
	cull	disable
    {
        map textures/colombia/bamboo_wall
        alphaFunc GE128
        blendFunc GL_SRC_ALPHA GL_ZERO
        depthWrite
    }
    {
        map $lightmap
        blendFunc GL_ONE GL_ZERO
        depthFunc equal
    }
    {
        map textures/colombia/bamboo_wall
        blendFunc GL_DST_COLOR GL_ZERO
        depthFunc equal
    }
}

textures/colombia/woodwall2b
{
// * 	surfaceparm	trans

	q3map_material	SolidWood
	cull	disable
	aliasShader	textures/colombia/woodwall2
    {
        map $lightmap
    }
    {
        map textures/colombia/woodwall2b
        blendFunc GL_DST_COLOR GL_ZERO
    }
}

