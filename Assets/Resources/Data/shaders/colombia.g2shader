textures/colombia/wake
{
	q3map_material	Water
	q3map_nolightmap
	q3map_onlyvertexlighting
    {
        clampmap textures/colombia/wake
        blendFunc GL_ONE GL_ONE
        tcMod turb 1 0.01 0.05 200
        tcMod stretch sin 1 0.05 0 100
    }
    {
        clampmap textures/colombia/wake
        blendFunc GL_ONE GL_ONE
        tcMod turb 1 0.04 0.05 200
        tcMod stretch sin 1 0.05 0 400
    }
}

