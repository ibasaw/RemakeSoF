	surfaceparm	playerclip
	surfaceparm	monsterclip
	q3map_material	Plastic
	cull	disable
    {
        map textures/colombia/viral_tent2
        alphaFunc GE128
        blendFunc GL_SRC_ALPHA GL_ZERO
        depthWrite
    }
    {
        map $lightmap
        blendFunc GL_ONE GL_ZERO
        depthFunc equal
    }
    {
        map textures/colombia/viral_tent2
        blendFunc GL_DST_COLOR GL_ZERO
        depthFunc equal
    }
}

